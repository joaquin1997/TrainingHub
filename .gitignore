node_modules
dist
.expo
.expo-shared
.DS_Store

# Expo continuous native generation output (regenerated via `expo prebuild`)
/apps/mobile/ios
/apps/mobile/android

# Local env files (never commit secrets)
.env
.env.local
.env.*.local

# Local scratch / temp data (e.g. importer source CSVs)
tmp/


# Compiler output must go to packages/domain/dist, never next to the sources
/packages/domain/src/**/*.js
/packages/domain/src/**/*.js.map
/packages/domain/src/**/*.d.ts
