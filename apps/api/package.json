{
  "name": "@workout/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:wger": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/import-wger-exercises.js",
    "import:wger:db": "IMPORT_TO_DB=true npm run import:wger"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "@workout/domain": "workspace:*",
    "fastify": "5.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.13",
    "prisma": "6.7.0",
    "vitest": "^4.1.7"
  }
}
