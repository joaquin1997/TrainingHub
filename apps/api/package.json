{
  "name": "@workout/api",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && rm -rf dist && tsc -p ../../packages/domain/tsconfig.json && tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:wger": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/import-wger-exercises.js",
    "import:wger:db": "IMPORT_TO_DB=true npm run import:wger",
    "import:images": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/match-free-exercise-images.js",
    "import:images:db": "IMPORT_TO_DB=true npm run import:images",
    "catalog:tracking-types": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/set-catalog-tracking-types.js",
    "catalog:tracking-sweep": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/sweep-tracking-types.js",
    "catalog:tracking-sweep:apply": "SWEEP_APPLY=true npm run catalog:tracking-sweep",
    "catalog:tracking-sweep:undo": "SWEEP_MODE=undo npm run catalog:tracking-sweep",
    "catalog:review": "npm run build && node dist/apps/api/src/scripts/catalog-review.js",
    "catalog:carry-over": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/catalog-carry-over.js",
    "catalog:curate": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/catalog-curate.js",
    "catalog:curate:apply": "CURATE_APPLY=true npm run catalog:curate",
    "catalog:curate:undo": "CURATE_MODE=undo npm run catalog:curate",
    "auth:reassign-dev-user": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/scripts/reassign-dev-user.js"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@prisma/client": "6.7.0",
    "@workout/domain": "workspace:*",
    "fastify": "5.5.0"
  },
  "devDependencies": {
    "@types/node": "20.19.13",
    "prisma": "6.7.0",
    "vitest": "^4.1.7"
  }
}
