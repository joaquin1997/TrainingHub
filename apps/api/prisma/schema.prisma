generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique
  displayName String
  email       String?   @unique
  passwordHash String?
  avatarUrl   String?
  unit        String    @default("kg")
  defaultRestSeconds Int @default(90)
  language    String?
  bio         String?
  heightCm    Float?
  photo       Bytes?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  routines        Routine[]
  exercises       Exercise[]
  workoutSessions WorkoutSession[]
  favoriteExercises ExerciseFavorite[]
  bodyMeasurements  BodyMeasurement[]
}

model BodyMeasurement {
  id             BigInt   @id @default(autoincrement())
  publicId       String   @unique @default(cuid())
  userId         BigInt
  measuredAt     DateTime
  weightKg       Float?
  bodyFatPercent Float?
  musclePercent  Float?
  neckCm         Float?
  chestCm        Float?
  waistCm        Float?
  hipsCm         Float?
  armCm          Float?
  forearmCm      Float?
  thighCm        Float?
  calfCm         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

model Exercise {
  id                        BigInt                       @id @default(autoincrement())
  publicId                  String                       @unique @default(cuid())
  source                    String
  sourceId                  String
  name                      String
  description               String?
  category                  String?
  language                  String?
  imageUrl                  String?
  equipment                 String[]
  licenseAuthor             String?
  lastSourceUpdate          DateTime?
  isSystemDefined           Boolean                      @default(true)
  /// What its sets record (spec 0021): weight_reps | reps | duration | weight_duration | distance_duration.
  trackingType              String                       @default("weight_reps")
  /// Done one side at a time; its sets record left and right reps (spec 0022).
  isUnilateral              Boolean                      @default(false)
  /// Set when its creator deleted this custom exercise (spec 0033): gone from the
  /// catalog and pickers, kept for the routines and workouts that contain it.
  deletedAt                 DateTime?
  createdByUserId           BigInt?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  createdByUser             User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  primaryMuscleGroupLinks   ExercisePrimaryMuscleGroup[]
  secondaryMuscleGroupLinks ExerciseSecondaryMuscleGroup[]
  routineExercises          RoutineExercise[]
  workoutExercises          WorkoutExercise[]
  favorites                 ExerciseFavorite[]
  photo                     ExercisePhoto?

  @@unique([source, sourceId])
  @@index([name])
}

model ExercisePhoto {
  id          BigInt   @id @default(autoincrement())
  exerciseId  BigInt   @unique
  data        Bytes
  updatedAt   DateTime @updatedAt
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model ExerciseFavorite {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  exerciseId BigInt
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
}

model MuscleGroup {
  id                     BigInt                         @id @default(autoincrement())
  name                   String                         @unique
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  primaryExerciseLinks   ExercisePrimaryMuscleGroup[]   @relation("PrimaryExerciseMuscleGroups")
  secondaryExerciseLinks ExerciseSecondaryMuscleGroup[] @relation("SecondaryExerciseMuscleGroups")
}

model ExercisePrimaryMuscleGroup {
  exerciseId    BigInt
  muscleGroupId BigInt
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup   MuscleGroup @relation("PrimaryExerciseMuscleGroups", fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model ExerciseSecondaryMuscleGroup {
  exerciseId    BigInt
  muscleGroupId BigInt
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup   MuscleGroup @relation("SecondaryExerciseMuscleGroups", fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model Routine {
  id          BigInt            @id @default(autoincrement())
  publicId    String            @unique @default(cuid())
  userId      BigInt
  name        String
  description String?
  folder      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       RoutineExercise[]
  warmUpItems     RoutineWarmUpItem[]
  workoutSessions WorkoutSession[]

  @@index([userId, createdAt])
}

/// One item of a routine's warm-up block (spec 0024): ticked, not logged.
model RoutineWarmUpItem {
  id                    BigInt   @id @default(autoincrement())
  routineId             BigInt
  orderIndex            Int
  name                  String
  targetDurationSeconds Int?
  targetReps            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  routine               Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, orderIndex])
}

model RoutineExercise {
  id           BigInt             @id @default(autoincrement())
  publicId     String             @unique @default(cuid())
  routineId    BigInt
  exerciseId   BigInt
  exerciseName String
  orderIndex   Int
  restSeconds  Int?
  supersetGroup Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise     Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets         RoutineExerciseSet[]
  workoutExercises WorkoutExercise[]

  @@index([exerciseId])
  @@index([routineId, orderIndex])
}

model RoutineExerciseSet {
  id                BigInt          @id @default(autoincrement())
  publicId          String          @unique @default(cuid())
  routineExerciseId BigInt
  setNumber         Int
  minReps           Int?
  maxReps           Int?
  targetWeight      Float?
  /// Target time in whole seconds (spec 0021).
  targetDurationSeconds Int?
  /// Target distance in metres (spec 0021).
  targetDistanceMeters Float?
  /// A warm-up (approach) set in the plan (spec 0024).
  isWarmup          Boolean         @default(false)
  /// Added by the warm-up action and untouched since (spec 0031); only with isWarmup.
  isGeneratedWarmup Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@index([routineExerciseId, setNumber])
}

model WorkoutSession {
  id          BigInt            @id @default(autoincrement())
  publicId    String            @unique @default(cuid())
  userId      BigInt
  routineId   BigInt?
  /// Device-chosen workout identity; a repeated save returns the first one (spec 0014).
  clientId    String?
  status      String
  startedAt   DateTime
  completedAt DateTime?
  /// Whole seconds paused; active duration = elapsed − this (spec 0011).
  pausedSeconds Int             @default(0)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine     Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  exercises   WorkoutExercise[]
  warmUpItems WorkoutWarmUpItem[]

  @@unique([userId, clientId])
  @@index([userId, startedAt])
}

/// A warm-up block item as performed, copied from the routine (spec 0024).
model WorkoutWarmUpItem {
  id                    BigInt         @id @default(autoincrement())
  workoutSessionId      BigInt
  order                 Int
  name                  String
  targetDurationSeconds Int?
  targetReps            Int?
  done                  Boolean        @default(false)
  createdAt             DateTime       @default(now())
  workoutSession        WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([workoutSessionId, order])
}

model WorkoutExercise {
  id                BigInt          @id @default(autoincrement())
  publicId          String          @unique @default(cuid())
  workoutSessionId  BigInt
  exerciseId        BigInt
  routineExerciseId BigInt?
  order             Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workoutSession    WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise          Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  routineExercise   RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  sets              WorkoutSet[]

  @@index([workoutSessionId, order])
  @@index([exerciseId])
}

model WorkoutSet {
  id                BigInt          @id @default(autoincrement())
  publicId          String          @unique @default(cuid())
  workoutExerciseId BigInt
  order             Int
  type              String          @default("normal")
  /// For a set with sides, the sum of repsLeft and repsRight (spec 0022).
  reps              Int?
  /// Reps per side of a unilateral exercise's set (spec 0022); null = not done.
  repsLeft          Int?
  repsRight         Int?
  weightKg          Float?
  durationSeconds   Int?
  distanceMeters    Float?
  restSeconds       Int?
  isWarmup          Boolean         @default(false)
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, order])
}
