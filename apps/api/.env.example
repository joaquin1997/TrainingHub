# Copy to .env and fill in real values. Never commit .env.
#
# Postgres connection. The dev database runs in a Docker container on the home
# server, published on the server's loopback only (127.0.0.1:5434). The deployed
# API (network_mode: host) uses this URL as-is; from the Mac, open an SSH tunnel
# first so the same URL works locally:
#   ssh -N -L 5434:127.0.0.1:5434 joaquin@joaquinserver.tail644a1a.ts.net
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5434/app_db?schema=public"

# Signs session tokens. Must match the deployed API's value, or every existing
# session is invalidated on redeploy.
JWT_SECRET=""

NODE_ENV=development
