# Copy to .env only when configuring an environment. Keep existing env files private.
# PostgreSQL runs on the server; a forwarded connection may use the same
# loopback URL from the development machine. Set the actual credentials privately.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5434/app_db?schema=public"

# Generate a random signing secret. Required outside development/test.
# Preserve the deployed value; changing it invalidates sessions.
JWT_SECRET=""
NODE_ENV=development

# Optional: comma-separated Google OAuth client IDs, not client secrets.
# GOOGLE_CLIENT_IDS=""
