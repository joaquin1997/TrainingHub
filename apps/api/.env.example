# Copy to .env and fill in real values. Never commit .env.
#
# Postgres connection. In this project the dev database runs in a Docker
# container on the home server, reachable over Tailscale (node: postgres-tailnet).
# Fallback without Tailscale: open an SSH tunnel and point host to localhost:
#   ssh -L 15432:localhost:5433 -N joaquin@192.168.1.98
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:15432/app_db?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@100.109.119.75:5432/app_db?schema=public"

NODE_ENV=development
