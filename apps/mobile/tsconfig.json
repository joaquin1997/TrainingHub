{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@workout/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@workout/domain/records": [
        "../../packages/domain/src/records.ts"
      ],
      "@/*": [
